    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "52S47UMZ3MuG",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "89b0c71d-b83c-4b18-9d75-9b3c00436cfa"
