      "cell_type": "markdown",
      "source": [
        "#6.2 Tuning XGBoost"
      ],
      "metadata": {
        "id": "TfMF2S43YI2Q"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from xgboost import XGBClassifier\n",
        "\n",
        "def objective_xgb_v2(trial):\n",
        "    params = {\n",
        "        'n_estimators'     : trial.suggest_int('n_estimators', 200, 700),\n",
        "        'max_depth'        : trial.suggest_int('max_depth', 3, 8),\n",
        "        'learning_rate'    : trial.suggest_float('learning_rate', 0.01, 0.15, log=True),\n",
        "        'subsample'        : trial.suggest_float('subsample', 0.6, 0.9),\n",
        "        'colsample_bytree' : trial.suggest_float('colsample_bytree', 0.5, 0.9),\n",
        "        'reg_alpha'        : trial.suggest_float('reg_alpha', 0.01, 10.0, log=True),\n",
        "        'reg_lambda'       : trial.suggest_float('reg_lambda', 0.01, 10.0, log=True),\n",
        "        'min_child_weight' : trial.suggest_int('min_child_weight', 5, 30),\n",
        "        'gamma'            : trial.suggest_float('gamma', 0.0, 1.0),\n",
        "        'random_state'     : SEED,\n",
        "        'verbosity'        : 0,\n",
        "        'eval_metric'      : 'mlogloss',\n",
        "        'n_jobs'           : 1,\n",
        "    }\n",
        "    smote_k     = trial.suggest_int('smote_k_neighbors', 3, 7)\n",
        "    w_dropout   = trial.suggest_float('w_dropout', 2.5, 5.0)\n",
        "    w_enrolled  = trial.suggest_float('w_enrolled', 1.0, 2.0)\n",
        "\n",
        "    skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)\n",
        "    val_f2s_dropout = []\n",
        "    train_f2s       = []\n",
        "    tp_enrolleds    = []\n",
        "    tp_graduates    = []\n",
        "    grad_to_enr     = []\n",
        "\n",
        "    for tr_idx, val_idx in skf.split(X_tune, y_tune):\n",
        "        X_f_tr, X_f_val = X_tune[tr_idx], X_tune[val_idx]\n",
        "        y_f_tr, y_f_val = y_tune[tr_idx], y_tune[val_idx]\n",
        "\n",
        "        sm = SMOTE(k_neighbors=smote_k, random_state=SEED)\n",
        "        X_res, y_res = sm.fit_resample(X_f_tr, y_f_tr)\n",
        "\n",
        "        sw_res = np.where(y_res == 0, w_dropout,\n",
        "                 np.where(y_res == 1, w_enrolled, 1.0))\n",
        "\n",
        "        clf = XGBClassifier(**params)\n",
        "        clf.fit(X_res, y_res, sample_weight=sw_res)\n",
        "\n",
        "        val_pred   = clf.predict(X_f_val)\n",
        "        train_pred = clf.predict(X_res)\n",
        "\n",
        "        val_f2 = fbeta_score(y_f_val, val_pred, beta=2,\n",
        "                              average=None, zero_division=0)[0]\n",
        "        train_f2 = fbeta_score(y_res, train_pred, beta=2,\n",
        "                                average=None, zero_division=0)[0]\n",
        "\n",
        "        val_f2s_dropout.append(val_f2)\n",
        "        train_f2s.append(train_f2)\n",
        "\n",
        "        cm_fold = confusion_matrix(y_f_val, val_pred, labels=[0,1,2])\n",
        "        tp_enrolleds.append(cm_fold[1, 1])\n",
        "        tp_graduates.append(cm_fold[2, 2])\n",
        "\n",
        "        total_grad = cm_fold[2].sum()\n",
        "        grad_to_enr.append(cm_fold[2, 1] / (total_grad + 1e-5))\n",
        "\n",
        "    mean_val      = np.mean(val_f2s_dropout)\n",
        "    mean_train    = np.mean(train_f2s)\n",
        "    mean_tp_enr   = np.mean(tp_enrolleds)\n",
        "    mean_tp_grad  = np.mean(tp_graduates)\n",
        "    mean_grad_enr = np.mean(grad_to_enr)\n",
        "    gap           = mean_train - mean_val\n",
        "\n",
        "    overfit_penalty  = max(0, gap - 0.08) * 1.5\n",
        "    underfit_penalty = max(0, 0.78 - mean_val) * 1.0\n",
        "    # TP Enrolled minimal ~10 per fold (≈50 total)\n",
        "    enrolled_penalty = max(0, 10 - mean_tp_enr) * 0.5\n",
        "    # TP Graduate minimal ~60 per fold (≈300 total)\n",
        "    graduate_penalty = max(0, 60 - mean_tp_grad) * 0.3\n",
        "    # Graduate → Enrolled jangan > 15%\n",
        "    grad_enr_penalty = max(0, mean_grad_enr - 0.15) * 2.0\n",
        "\n",
        "    return mean_val - overfit_penalty - underfit_penalty - enrolled_penalty - graduate_penalty - grad_enr_penalty\n",
        "\n",
        "study_xgb_v2 = optuna.create_study(\n",
        "    direction='maximize',\n",
        "    sampler=optuna.samplers.TPESampler(seed=SEED)\n",
        ")\n",
        "study_xgb_v2.optimize(objective_xgb_v2, n_trials=100, show_progress_bar=True)\n",
        "\n",
        "print(f\"\\nBest Score XGBoost v2 : {study_xgb_v2.best_value:.4f}\")\n",
        "print(f\"Best Params           : {study_xgb_v2.best_params}\")\n",
        "\n",
        "best_params_xgb_v2 = dict(study_xgb_v2.best_params)\n",
        "smote_k_xgb_v2     = best_params_xgb_v2.pop('smote_k_neighbors')\n",
        "w_dropout_v2       = best_params_xgb_v2.pop('w_dropout')\n",
        "w_enrolled_v2      = best_params_xgb_v2.pop('w_enrolled')\n",
        "\n",
        "sm_xgb_v2 = SMOTE(k_neighbors=smote_k_xgb_v2, random_state=SEED)\n",
        "X_tr_sm_xgb_v2, y_tr_sm_xgb_v2 = sm_xgb_v2.fit_resample(\n",
        "    X_train_tree[best_cols_tree], y_train\n",
        ")\n",
        "\n",
        "sw_final_v2 = np.where(y_tr_sm_xgb_v2 == 0, w_dropout_v2,\n",
        "              np.where(y_tr_sm_xgb_v2 == 1, w_enrolled_v2, 1.0))\n",
        "\n",
        "final_model_xgb_v2 = XGBClassifier(**best_params_xgb_v2, random_state=SEED,\n",
        "                                    verbosity=0, eval_metric='mlogloss', n_jobs=1)\n",
        "final_model_xgb_v2.fit(X_tr_sm_xgb_v2, y_tr_sm_xgb_v2, sample_weight=sw_final_v2)\n",
        "print(\"\\nFinal XGBoost v2 trained.\")"
      ],
