        "cat_cols = X_train_clean.select_dtypes(include=['object']).columns.tolist()\n",
        "\n",
        "# Memastikan cat_cols tidak kosong sebelum memanggil associations\n",
        "if not cat_cols:\n",
        "    print(\"Tidak ada kolom kategorikal (object dtype) yang ditemukan untuk dianalisis.\")\n",
        "    cramers_v_matrix = pd.DataFrame() # Atau penanganan lain yang sesuai\n",
