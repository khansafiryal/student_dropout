      "source": [
        "# e. Scaling Data dengan Robust Scaler\n",
        "![image.png](data:image/png;base64,)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "8VuE-8dYYFOY"
      },
      "outputs": [],
      "source": [
        "from sklearn.preprocessing import RobustScaler\n",
        "num_cols = ['previous_grade',\n",
        "       'admission_grade', 'age_at_enrollment',\n",
        "       'Curricular units 1st sem (evaluations)',\n",
        "       'Curricular units 1st sem (grade)',\n",
        "       'Curricular units 2nd sem (evaluations)',\n",
        "       'Curricular units 2nd sem (grade)', 'unemployment_rate',\n",
        "       'inflation_rate', 'gdp', 'approved_sem1&2_pca', 'enrolled_sem1&2_pca']\n",
        "\n",
        "# Jalankan Scaler\n",
        "scaler = RobustScaler()\n",
        "X_train_scaled_raw = scaler.fit_transform(X_train_clean[num_cols])\n",
        "X_test_scaled_raw = scaler.transform(X_test_clean[num_cols])\n",
        "\n",
        "# Ubah hasil scaled (yang bentuknya array) jadi DataFrame agar mudah digabung\n",
        "X_train_scaled_df = pd.DataFrame(X_train_scaled_raw, columns=num_cols, index=X_train_clean.index)\n",
        "X_test_scaled_df = pd.DataFrame(X_test_scaled_raw, columns=num_cols, index=X_test_clean.index)\n",
        "\n",
        "# Update kolom numerik di X_train_clean dengan versi yang sudah di-scale\n",
        "X_train_final = X_train_clean.copy()\n",
        "X_test_final = X_test_clean.copy()\n",
        "\n",
        "X_train_final[num_cols] = X_train_scaled_df[num_cols]\n",
        "X_test_final[num_cols] = X_test_scaled_df[num_cols]"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "HBz2LCKRAlig"
      },
      "source": [
        "<div align='justify'> RobustScaler dipilih karena fitur seperti admission_grade, previous_grade, dan age_at_enrollment banyak mengandung natural outlier. Pada fitur grade, wajar ada mahasiswa dengan nilai yang sangat tinggi atau sangat rendah. Pada age_at_enrollment, mayoritas mahasiswa masuk di usia 17-20 tahun, namun ada mahasiswa yang mendaftar di usia jauh lebih tua yang merupakan kondisi nyata dan tidak bisa dihapus begitu saja. Karena outlier-outlier ini alami dan bermakna, RobustScaler yang berbasis median dan IQR lebih tepat digunakan agar nilai ekstrem tersebut tidak mendistorsi proses scaling.</div>"
      ]
    },
