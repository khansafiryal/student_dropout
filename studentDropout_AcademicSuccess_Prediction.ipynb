        "ax.set_title(f'Learning Curve - {best_model_name_tree} ({best_fs_label_tree})  |  {status}',\n",
        "             fontsize=12, fontweight='bold')\n",
        "ax.set_xlabel('Training Samples'); ax.set_ylabel('Accuracy')\n",
        "ax.set_ylim(0, 1.05); ax.legend(); ax.grid(alpha=0.3)\n",
        "plt.tight_layout();\n",
        "plt.savefig('learning_curve_best_model_tree-based.png', dpi=150, bbox_inches='tight')\n",
        "plt.show()\n",
        "\n",
        "print(f\"Gap (Train - CV Acc): {gap:.4f}  : {status}\")\n"
      ]
