      "cell_type": "code",
      "source": [
        "import warnings\n",
        "import optuna\n",
        "import numpy as np\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "from sklearn.model_selection import StratifiedKFold\n",
        "from sklearn.metrics import fbeta_score\n",
        "from imblearn.over_sampling import SMOTE\n",
        "\n",
        "warnings.filterwarnings('ignore')\n",
        "optuna.logging.set_verbosity(optuna.logging.WARNING)\n",
        "\n",
        "SEED        = 42\n",
        "DROPOUT_IDX = 0\n",
        "\n",
        "X_tune = X_train_tree[best_cols_tree].values\n",
        "y_tune = y_train\n",
        "\n",
        "def objective_rf(trial):\n",
        "    params = {\n",
        "        'n_estimators'         : trial.suggest_int('n_estimators', 200, 600),\n",
        "        'max_depth'            : trial.suggest_int('max_depth', 4, 12),\n",
        "        'min_samples_leaf'     : trial.suggest_int('min_samples_leaf', 10, 60),\n",
        "        'min_samples_split'    : trial.suggest_int('min_samples_split', 20, 100),\n",
        "        'max_features'         : trial.suggest_float('max_features', 0.3, 0.7),\n",
        "        'min_impurity_decrease': trial.suggest_float('min_impurity_decrease', 1e-6, 1e-3, log=True),\n",
        "        'class_weight'         : trial.suggest_categorical('class_weight', [\n",
        "            {0: 3.0, 1: 2.0, 2: 1.0},\n",
        "            {0: 2.5, 1: 2.0, 2: 1.0},\n",
        "            {0: 3.0, 1: 1.5, 2: 1.0},\n",
        "            {0: 2.0, 1: 2.0, 2: 1.0},\n",
        "            {0: 2.5, 1: 1.5, 2: 1.0},\n",
        "            'balanced_subsample',\n",
        "        ]),\n",
        "        'random_state': SEED,\n",
        "        'n_jobs'      : -1,\n",
        "    }\n",
        "    smote_k = trial.suggest_int('smote_k_neighbors', 3, 7)\n",
        "\n",
        "    skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)\n",
        "    val_f2s, train_f2s = [], []\n",
        "\n",
        "    for tr_idx, val_idx in skf.split(X_tune, y_tune):\n",
        "        X_f_tr, X_f_val = X_tune[tr_idx], X_tune[val_idx]\n",
        "        y_f_tr, y_f_val = y_tune[tr_idx], y_tune[val_idx]\n",
        "\n",
        "        sm = SMOTE(k_neighbors=smote_k, random_state=SEED)\n",
        "        X_res, y_res = sm.fit_resample(X_f_tr, y_f_tr)\n",
        "\n",
        "        clf = RandomForestClassifier(**params)\n",
        "        clf.fit(X_res, y_res)\n",
        "\n",
        "        train_f2 = fbeta_score(y_res,   clf.predict(X_res),   beta=2, average=None, zero_division=0)[DROPOUT_IDX]\n",
        "        val_f2   = fbeta_score(y_f_val, clf.predict(X_f_val), beta=2, average=None, zero_division=0)[DROPOUT_IDX]\n",
        "        train_f2s.append(train_f2)\n",
        "        val_f2s.append(val_f2)\n",
        "\n",
        "    mean_val   = np.mean(val_f2s)\n",
        "    mean_train = np.mean(train_f2s)\n",
        "    gap        = mean_train - mean_val\n",
        "\n",
        "    overfit_penalty  = max(0, gap - 0.08) * 1.5\n",
        "    underfit_penalty = max(0, 0.70 - mean_val) * 0.5\n",
        "\n",
        "    return mean_val - overfit_penalty - underfit_penalty\n",
        "\n",
        "study_rf = optuna.create_study(\n",
        "    direction='maximize',\n",
        "    sampler=optuna.samplers.TPESampler(seed=SEED)\n",
        ")\n",
        "study_rf.optimize(objective_rf, n_trials=75, show_progress_bar=True)\n",
        "\n",
        "print(f\"\\nBest Score RF : {study_rf.best_value:.4f}\")\n",
        "print(f\"Best Params   : {study_rf.best_params}\")\n",
        "\n",
        "best_params_rf = dict(study_rf.best_params)\n",
        "smote_k_rf     = best_params_rf.pop('smote_k_neighbors')\n",
        "\n",
        "sm_rf = SMOTE(k_neighbors=smote_k_rf, random_state=SEED)\n",
        "X_tr_sm_rf, y_tr_sm_rf = sm_rf.fit_resample(X_train_tree[best_cols_tree], y_train)\n",
        "\n",
        "final_model_rf = RandomForestClassifier(**best_params_rf, random_state=SEED, n_jobs=-1)\n",
        "final_model_rf.fit(X_tr_sm_rf, y_tr_sm_rf)\n",
        "print(\"\\nFinal Random Forest trained.\")"
      ],
      "metadata": {
        "id": "MJbAuQ2cYB7m",
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 136,
