        "from sklearn.feature_selection import mutual_info_classif\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "X = X_train_tree\n",
        "y = y_train\n",
        "\n",
        "discrete_mask = [col in cat_cols_mi for col in X.columns]\n",
        "\n",
        "mi_scores = mutual_info_classif(X, y, discrete_features=discrete_mask, random_state=42)\n",
        "\n",
        "mi_summary = pd.DataFrame({\n",
        "    'Feature': X.columns,\n",
        "    'MI_Score': mi_scores\n",
        "}).sort_values(by='MI_Score', ascending=False)\n",
        "\n",
        "n_features = len(mi_summary)\n",
        "fig_height = max(6, n_features * 0.4)\n",
        "fig, ax = plt.subplots(figsize=(10, fig_height))\n",
        "\n",
        "colors = ['#e74c3c' if s > 0.05 else '#3498db' if s > 0.01 else '#bdc3c7'\n",
        "          for s in mi_summary['MI_Score']]\n",
        "bars = ax.barh(mi_summary['Feature'], mi_summary['MI_Score'],\n",
        "               color=colors, height=0.5, edgecolor='white')\n",
        "for bar, score in zip(bars, mi_summary['MI_Score']):\n",
        "    ax.text(bar.get_width() + 0.001, bar.get_y() + bar.get_height()/2,\n",
        "            f'{score:.4f}', va='center', fontsize=8)\n",
        "\n",
        "ax.set_xlabel('Mutual Information Score', fontsize=11)\n",
        "ax.set_title('Mutual Information (Tree-Based Pipeline)', fontsize=13, fontweight='bold')\n",
        "ax.grid(alpha=0.3, axis='x')\n",
        "plt.tight_layout()\n",
        "plt.savefig('mi_tree_based.png', dpi=150, bbox_inches='tight')\n",
        "plt.show()"
      ]
    },
