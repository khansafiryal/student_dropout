    {
      "cell_type": "markdown",
      "source": [
        "#6.3 Tuning LightGBM"
      ],
      "metadata": {
        "id": "Resiwy4CYRyR"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from lightgbm import LGBMClassifier\n",
        "\n",
        "def objective_lgbm(trial):\n",
        "    params = {\n",
        "        'n_estimators'      : trial.suggest_int('n_estimators', 200, 700),\n",
        "        'max_depth'         : trial.suggest_int('max_depth', 3, 8),\n",
        "        'learning_rate'     : trial.suggest_float('learning_rate', 0.01, 0.15, log=True),\n",
        "        'num_leaves'        : trial.suggest_int('num_leaves', 15, 50),\n",
        "        'subsample'         : trial.suggest_float('subsample', 0.6, 0.9),\n",
        "        'colsample_bytree'  : trial.suggest_float('colsample_bytree', 0.5, 0.9),\n",
        "        'reg_alpha'         : trial.suggest_float('reg_alpha', 0.01, 10.0, log=True),\n",
        "        'reg_lambda'        : trial.suggest_float('reg_lambda', 0.01, 10.0, log=True),\n",
        "        'min_child_samples' : trial.suggest_int('min_child_samples', 20, 100),\n",
        "        'min_gain_to_split' : trial.suggest_float('min_gain_to_split', 0.0, 1.0),\n",
        "        'class_weight'      : trial.suggest_categorical('class_weight', [\n",
        "            {0: 3.0, 1: 2.0, 2: 1.0},\n",
        "            {0: 2.5, 1: 2.0, 2: 1.0},\n",
        "            {0: 3.0, 1: 1.5, 2: 1.0},\n",
        "            {0: 2.0, 1: 2.0, 2: 1.0},\n",
        "            {0: 2.5, 1: 1.5, 2: 1.0},\n",
        "            'balanced',\n",
        "        ]),\n",
        "        'random_state': SEED,\n",
        "        'verbose'     : -1,\n",
        "        'n_jobs'      : -1,\n",
        "    }\n",
        "    smote_k = trial.suggest_int('smote_k_neighbors', 3, 7)\n",
        "\n",
        "    skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)\n",
        "    val_f2s, train_f2s = [], []\n",
        "\n",
        "    for tr_idx, val_idx in skf.split(X_tune, y_tune):\n",
        "        X_f_tr, X_f_val = X_tune[tr_idx], X_tune[val_idx]\n",
        "        y_f_tr, y_f_val = y_tune[tr_idx], y_tune[val_idx]\n",
        "\n",
        "        sm = SMOTE(k_neighbors=smote_k, random_state=SEED)\n",
        "        X_res, y_res = sm.fit_resample(X_f_tr, y_f_tr)\n",
        "\n",
        "        clf = LGBMClassifier(**params)\n",
        "        clf.fit(X_res, y_res)\n",
        "\n",
        "        train_f2 = fbeta_score(y_res,   clf.predict(X_res),   beta=2, average=None, zero_division=0)[DROPOUT_IDX]\n",
        "        val_f2   = fbeta_score(y_f_val, clf.predict(X_f_val), beta=2, average=None, zero_division=0)[DROPOUT_IDX]\n",
        "        train_f2s.append(train_f2)\n",
        "        val_f2s.append(val_f2)\n",
        "\n",
        "    mean_val   = np.mean(val_f2s)\n",
        "    mean_train = np.mean(train_f2s)\n",
        "    gap        = mean_train - mean_val\n",
        "\n",
        "    overfit_penalty  = max(0, gap - 0.08) * 1.5\n",
        "    underfit_penalty = max(0, 0.70 - mean_val) * 0.5\n",
        "\n",
        "    return mean_val - overfit_penalty - underfit_penalty\n",
        "\n",
        "study_lgbm = optuna.create_study(\n",
        "    direction='maximize',\n",
        "    sampler=optuna.samplers.TPESampler(seed=SEED)\n",
        ")\n",
        "study_lgbm.optimize(objective_lgbm, n_trials=75, show_progress_bar=True)\n",
        "\n",
        "print(f\"\\nBest Score LightGBM : {study_lgbm.best_value:.4f}\")\n",
        "print(f\"Best Params         : {study_lgbm.best_params}\")\n",
        "\n",
        "best_params_lgbm = dict(study_lgbm.best_params)\n",
        "smote_k_lgbm     = best_params_lgbm.pop('smote_k_neighbors')\n",
        "\n",
        "sm_lgbm = SMOTE(k_neighbors=smote_k_lgbm, random_state=SEED)\n",
        "X_tr_sm_lgbm, y_tr_sm_lgbm = sm_lgbm.fit_resample(X_train_tree[best_cols_tree], y_train)\n",
        "\n",
        "final_model_lgbm = LGBMClassifier(**best_params_lgbm, random_state=SEED, verbose=-1, n_jobs=-1)\n",
        "final_model_lgbm.fit(X_tr_sm_lgbm, y_tr_sm_lgbm)\n",
        "print(\"\\nFinal LightGBM trained.\")"
      ],
      "metadata": {
