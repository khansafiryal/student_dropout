      "source": [
        "# FEATURE SELECTION COMPARISON (Train/Val/Test) — Non-Tree-Based\n",
        "\n",
        "from sklearn.model_selection import train_test_split, StratifiedKFold, learning_curve\n",
        "from sklearn.metrics import (\n",
        "    accuracy_score, fbeta_score, f1_score,\n",
        "    precision_score, recall_score\n",
        ")\n",
        "from imblearn.pipeline import Pipeline as ImbPipeline\n",
        "from imblearn.over_sampling import SMOTE\n",
        "from sklearn.naive_bayes import GaussianNB\n",
        "from sklearn.neighbors import KNeighborsClassifier\n",
        "\n",
        "# Train / Val / Test split\n",
        "X_tr_nt, X_val_nt, y_tr_nt, y_val_nt = train_test_split(\n",
        "    X_train_final, y_train,\n",
        "    test_size=0.2,\n",
        "    stratify=y_train,\n",
        "    random_state=42,\n",
        ")\n",
        "\n",
        "print(f\"Train : {X_tr_nt.shape[0]} | Val : {X_val_nt.shape[0]} | Test : {X_test_final.shape[0]}\")\n",
        "\n",
        "DROPOUT_IDX = 0\n",
        "\n",
        "# 1. Helper metrik\n",
        "def compute_metrics_nt(y_true, y_pred, prefix=''):\n",
        "    return {\n",
        "        f'{prefix}Accuracy'   : round(accuracy_score(y_true, y_pred), 4),\n",
        "        f'{prefix}Precision'  : round(precision_score(y_true, y_pred, average='macro', zero_division=0), 4),\n",
        "        f'{prefix}Recall'     : round(recall_score   (y_true, y_pred, average='macro', zero_division=0), 4),\n",
        "        f'{prefix}F1'         : round(f1_score       (y_true, y_pred, average='macro', zero_division=0), 4),\n",
        "        f'{prefix}F2 Dropout' : round(fbeta_score(y_true, y_pred, beta=2, average=None,\n",
        "                                      zero_division=0)[DROPOUT_IDX], 4),\n",
        "    }\n",
        "\n",
        "def get_models_nontree():\n",
        "    return {\n",
        "        'KNN'        : KNeighborsClassifier(),\n",
        "        'Naive Bayes': GaussianNB(),\n",
        "    }\n",
        "\n",
        "# 2. Definisikan fs_scenarios_nontree (Menggunakan mi_summary_2 dan sfs_nontree)\n",
        "features_mi_nontree = mi_summary_2.loc[mi_summary_2['MI_Score'] > 0.01, 'Feature'].tolist()\n",
        "forward_nontree     = list(sfs_nontree.k_feature_names_)\n",
        "\n",
        "features_mi_nontree = [f for f in features_mi_nontree if f in X_tr_nt.columns]\n",
        "forward_nontree     = [f for f in forward_nontree     if f in X_tr_nt.columns]\n",
        "\n",
        "fs_scenarios_nontree = [\n",
        "    ('All Features',                 list(X_tr_nt.columns)),\n",
        "    ('MI > 0.01',                    features_mi_nontree),\n",
        "    ('Sequential Forward Selection', forward_nontree),\n",
        "]\n",
        "\n",
        "# 3. Loop FS x Model\n",
        "rows = []\n",
        "model_store_nontree = {}  # simpan fitted model: (fs_label, model_name) -> (model, cols)\n",
        "\n",
        "for fs_label, cols in fs_scenarios_nontree:\n",
        "    cols = [c for c in cols if c in X_tr_nt.columns]\n",
        "\n",
        "    X_tr_sel  = X_tr_nt[cols].copy()\n",
        "    X_val_sel = X_val_nt[cols].copy()\n",
        "    X_te_sel  = X_test_final[cols].copy()\n",
        "\n",
        "    sm = SMOTE(random_state=42)\n",
        "    X_tr_sm, y_tr_sm = sm.fit_resample(X_tr_sel, y_tr_nt)\n",
        "\n",
        "    for model_name, model in get_models_nontree().items():\n",
        "        model.fit(X_tr_sm, y_tr_sm)\n",
        "        model_store_nontree[(fs_label, model_name)] = (model, cols)\n",
        "\n",
        "        val_m  = compute_metrics_nt(y_val_nt, model.predict(X_val_sel), prefix='Val ')\n",
        "        test_m = compute_metrics_nt(y_test,   model.predict(X_te_sel),  prefix='Test ')\n",
        "\n",
        "        rows.append({\n",
        "            'FS'     : fs_label,\n",
        "            'N Fitur': len(cols),\n",
        "            'Model'  : model_name,\n",
        "            **val_m,\n",
        "            **test_m,\n",
        "        })\n",
        "\n",
        "df_all_nontree = (pd.DataFrame(rows)\n",
        "                    .sort_values('Test F2 Dropout', ascending=False)\n",
        "                    .reset_index(drop=True))\n",
        "df_all_nontree.index += 1\n",
        "\n",
        "# 4. Tabel perbandingan\n",
        "val_cols  = ['FS', 'N Fitur', 'Model',\n",
        "             'Val Accuracy', 'Val Precision', 'Val Recall', 'Val F1', 'Val F2 Dropout']\n",
        "test_cols = ['FS', 'Model',\n",
        "             'Test Accuracy', 'Test Precision', 'Test Recall', 'Test F1', 'Test F2 Dropout']\n",
        "\n",
        "print(\"\\n\" + \"=\"*65)\n",
        "print(\"TABEL PERBANDINGAN VAL\")\n",
        "print(\"=\"*65)\n",
        "print(df_all_nontree[val_cols].to_string())\n",
        "\n",
        "print(\"\\n\" + \"=\"*65)\n",
        "print(\"  TABEL PERBANDINGAN TEST\")\n",
        "print(\"=\"*65)\n",
        "print(df_all_nontree[test_cols].to_string())\n",
        "\n",
        "# 5. Best model\n",
        "best_nontree = df_all_nontree.iloc[0]\n",
        "\n",
        "print(\"\\n\" + \"=\"*65)\n",
        "print(\"BEST MODEL AND FEATURE SELECTION NON-TREE\")\n",
