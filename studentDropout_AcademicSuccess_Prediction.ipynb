    {
      "cell_type": "code",
      "source": [
        "from sklearn.metrics import accuracy_score, f1_score\n",
        "\n",
        "def eval_tuned(name, model, X_te, y_te):\n",
        "    y_pred = model.predict(X_te)\n",
        "    return {\n",
        "        'Model'      : name,\n",
        "        'Accuracy'   : round(accuracy_score(y_te, y_pred), 4),\n",
        "        'F1 Macro'   : round(f1_score(y_te, y_pred, average='macro', zero_division=0), 4),\n",
        "        'F2 Dropout' : round(fbeta_score(y_te, y_pred, beta=2, average=None, zero_division=0)[DROPOUT_IDX], 4),\n",
        "    }\n",
        "\n",
        "df_tuned_compare = pd.DataFrame([\n",
        "    eval_tuned('Random Forest (Tuned)', final_model_rf,   X_te, y_test),\n",
        "    eval_tuned('XGBoost (Tuned)',       final_model_xgb_v2,  X_te, y_test),\n",
        "    eval_tuned('LightGBM (Tuned)',      final_model_lgbm, X_te, y_test),\n",
        "]).sort_values('F2 Dropout', ascending=False).reset_index(drop=True)\n",
        "\n",
        "print('=' * 60)\n",
        "print('  PERBANDINGAN SEMUA TUNED MODEL')\n",
        "print('=' * 60)\n",
        "print(df_tuned_compare.to_string(index=False))\n",
        "\n",
        "best_tuned_model = df_tuned_compare.iloc[0]\n",
        "print(f\"\\nModel Terpilih : {best_tuned_model['Model']}\")\n",
        "print(f\"F2 Dropout     : {best_tuned_model['F2 Dropout']:.4f}\")\n",
        "print(f\"Accuracy       : {best_tuned_model['Accuracy']:.4f}\")"
