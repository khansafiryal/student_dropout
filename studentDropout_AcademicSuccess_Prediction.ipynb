      "source": [
        "from mlxtend.feature_selection import SequentialFeatureSelector as SFS\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "\n",
        "rf_sfs = RandomForestClassifier(random_state=42)\n",
        "\n",
        "sfs_tree = SFS(rf_sfs,\n",
        "               k_features='best',\n",
        "               forward=True,\n",
        "               floating=False,\n",
        "               scoring='accuracy',\n",
        "               cv=5)\n",
        "\n",
        "sfs_tree = sfs_tree.fit(X_train_tree, y_train)\n",
        "\n",
        "print(\"Selected Features ID :\", sfs_tree.k_feature_idx_)\n",
        "print(\"Selected Features Name:\", sfs_tree.k_feature_names_)\n",
        "\n",
        "metric_dict = sfs_tree.get_metric_dict()\n",
        "k_list     = sorted(metric_dict.keys())\n",
        "avg_scores = [metric_dict[k]['avg_score'] for k in k_list]\n",
        "best_k     = sfs_tree.k_feature_idx_\n",
        "best_score = metric_dict[len(best_k)]['avg_score']\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(14, 5))\n",
        "ax.plot(k_list, avg_scores, 'o-', color='steelblue', linewidth=2,\n",
        "        markersize=5, label='CV Accuracy')\n",
        "ax.axvline(len(best_k), color='#e74c3c', linestyle='--', linewidth=1.5,\n",
        "           label=f'Best k={len(best_k)} (Acc={best_score:.4f})')\n",
        "ax.scatter([len(best_k)], [best_score], color='#e74c3c', zorder=5, s=80)\n",
        "ax.set_xlabel('Number of Features', fontsize=11)\n",
        "ax.set_ylabel('CV Accuracy (5-fold)', fontsize=11)\n",
        "ax.set_title('Sequential Forward Selection — Tree-Based Pipeline', fontsize=13, fontweight='bold')\n",
        "ax.set_xticks(k_list)\n",
        "ax.set_xticklabels(k_list, fontsize=8)\n",
        "ax.legend(fontsize=9)\n",
        "ax.grid(alpha=0.3)\n",
        "plt.tight_layout()\n",
        "plt.savefig('sfs_tree_based.png', dpi=150, bbox_inches='tight')\n",
        "plt.show()"
      ]
