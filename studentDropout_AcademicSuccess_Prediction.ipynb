    {
      "cell_type": "markdown",
      "source": [
        "2.1 Hitung Bias Corrected Cramers V Kolom Rendundant ke Target"
      ],
      "metadata": {
        "id": "gTLmiVr1n7aq"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from scipy import stats\n",
        "\n",
        "# Fungsi Chi-Square + Cramér's V\n",
        "def chi_square_test(X_train_clean, col1, col2, alpha=0.05):\n",
        "    # Contingency table\n",
        "    ct = pd.crosstab(X_train_clean[col1], col2)\n",
        "\n",
        "    # Chi-square test\n",
        "    chi2, p_value, dof, expected = stats.chi2_contingency(ct)\n",
        "\n",
        "    # Nilai kritis\n",
        "    critical_value = stats.chi2.ppf(1 - alpha, dof)\n",
        "\n",
        "    # Print hasil\n",
        "    print(f\"Contingency Table:\\n{ct}\\n\")\n",
        "    print(f\"Chi-Square : {chi2:.4f}\")\n",
        "    if p_value < 0.001:\n",
        "        print(f\"P-Value    : < 0.001\")\n",
        "    else:\n",
        "        print(f\"P-Value    : {p_value:.4f}\")\n",
        "    print(f\"Df         : {dof}\")\n",
        "    print(f\"Nilai Kritis (α={alpha}): {critical_value:.4f}\")\n",
        "    print(f\"Keputusan  : {'Tolak H0 → Dependen' if p_value < alpha else 'Terima H0 → Independen'}\")\n",
        "\n",
        "    # Plot distribusi\n",
        "    x = np.linspace(0, max(chi2 * 1.5, critical_value * 1.5), 1000)\n",
        "    y = stats.chi2.pdf(x, dof)\n",
        "    plt.figure(figsize=(8, 4))\n",
        "    plt.plot(x, y, color='black')\n",
        "    plt.fill_between(x, y, where=(x > critical_value), color='red', alpha=0.4, label=f'Critical Region (α={alpha})')\n",
        "    plt.axvline(chi2, color='blue', linestyle='--', label=f'Chi-Square = {chi2:.4f}')\n",
        "    plt.axvline(critical_value, color='red', linestyle='--', label=f'Critical Value = {critical_value:.4f}')\n",
        "    plt.title(f'Chi-Square Test: {col1} vs Target')\n",
        "    plt.legend()\n",
        "    plt.grid()\n",
        "    plt.savefig(f'chi-square{col1} dengan target.png', dpi=150, bbox_inches='tight')\n",
        "    plt.show()\n",
        "\n",
        "    # Bias-corrected Cramér's V\n",
        "    n = ct.sum().sum()\n",
        "    r, k = ct.shape\n",
        "    phi2 = chi2 / n\n",
        "    phi2_corr = max(0, phi2 - (k-1)*(r-1)/(n-1))\n",
        "    k_corr = k - (k-1)**2 / (n-1)\n",
        "    r_corr = r - (r-1)**2 / (n-1)\n",
        "    cramers = np.sqrt(phi2_corr / (min(k_corr, r_corr) - 1))\n",
        "\n",
        "    if cramers > 0.25:\n",
        "        asosiasi = \"Very strong\"\n",
        "    elif cramers > 0.15:\n",
        "        asosiasi = \"Strong\"\n",
        "    elif cramers > 0.10:\n",
        "        asosiasi = \"Moderate\"\n",
        "    elif cramers > 0.05:\n",
        "        asosiasi = \"Weak\"\n",
        "    else:\n",
        "        asosiasi = \"No or very weak\"\n",
        "    print(f\"Bias-Corrected Cramér's V : {cramers:.4f} → {asosiasi}\")\n",
        "\n",
        "    return cramers\n",
        "\n",
        "# Cek 4 kolom tertentu terhadap target\n",
        "cols_to_check = ['major', 'attendance_time', 'nationality', 'international']\n",
        "\n",
        "cramers_results = []\n",
        "\n",
        "for col in cols_to_check:\n",
        "    print(f\"\\n{col} vs Target\")\n",
        "    cramers_v = chi_square_test(X_train_clean, col, y_train)\n",
        "    cramers_results.append({'Fitur': col, \"Cramers V\": cramers_v})\n",
        "    print()"
