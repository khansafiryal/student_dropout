            ]
          },
          "metadata": {},
          "execution_count": 71
        }
      ],
      "source": [
        "threshold = 0.8\n",
        "redundant_pairs = []\n",
        "for i in range(len(corr_spearman.columns)):\n",
        "    for j in range(i):\n",
        "        if abs(corr_spearman.iloc[i, j]) > threshold:\n",
        "            redundant_pairs.append({\n",
        "                'Fitur 1': corr_spearman.columns[i],\n",
        "                'Fitur 2': corr_spearman.columns[j],\n",
        "                'Korelasi Spearman': corr_spearman.iloc[i, j]\n",
        "            })\n",
        "\n",
        "redundant_df = pd.DataFrame(redundant_pairs).sort_values(by='Korelasi Spearman', ascending=False)\n",
        "redundant_df"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "lK1aNKLrcRIF"
      },
      "source": [
        "<div align='stratify'> Berdasarkan hasil analisis menggunakan Spearman, ditemukan adanya korelasi yang tinggi antar beberapa fitur, khususnya pada variabel performa akademik di semester yang berurutan. Hal ini menunjukkan adanya redundansi informasi, yaitu kondisi di mana beberapa fitur memiliki informasi yang saling tumpang tindih. Meskipun demikian, kondisi ini tidak selalu menjadi permasalahan dalam proses pemodelan, terutama pada algoritma berbasis pohon seperti Random Forest dan LightGBM. Hal ini dikarenakan model tersebut tidak bergantung pada asumsi hubungan linear antar variabel serta mampu memilih fitur secara otomatis melalui proses splitting, sehingga tetap dapat mengekstraksi pola penting meskipun terdapat fitur yang saling berkorelasi. Oleh karena itu, fitur-fitur dengan korelasi tinggi tidak dihapus karena masih mengandung informasi yang relevan, khususnya dalam merepresentasikan pola perkembangan data secara temporal.\n",
        "</div>"
      ]
    },
