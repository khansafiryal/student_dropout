      "source": [
        "def fix_grade(col):\n",
        "    col = col.astype(str)\n",
        "\n",
        "    col = col.apply(\n",
        "        lambda x: '.'.join(x.split('.')[:2]) if x.count('.') > 1 else x\n",
        "    )\n",
        "\n",
        "    return pd.to_numeric(col)\n",
        "\n",
        "grade_cols = [\n",
        "    'Curricular units 1st sem (grade)',\n",
        "    'Curricular units 2nd sem (grade)'\n",
        "]\n",
        "\n",
        "for col in grade_cols:\n",
        "    df[col] = fix_grade(df[col])\n",
        "df[grade_cols].info()\n",
        "df[grade_cols].head()"
      ]
    },
