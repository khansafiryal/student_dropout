          "text": [
            "X_train_clean: 33 kolom\n"
          ]
        }
      ],
      "source": [
        "from category_encoders import CountEncoder\n",
        "from sklearn.preprocessing import LabelEncoder\n",
        "\n",
        "cat_clean = X_train_clean.select_dtypes(include=['category', 'object']).columns.tolist()\n",
        "cat_clean_mi = cat_clean.copy()\n",
        "\n",
        "binary_clean = []\n",
        "nominal_clean = []\n",
        "ordinal_features = ['choice_priority']\n",
        "\n",
        "for col in cat_clean:\n",
        "    if col in ordinal_features:\n",
        "        continue\n",
        "    if X_train_clean[col].nunique() == 2:\n",
        "        binary_clean.append(col)\n",
        "    else:\n",
        "        nominal_clean.append(col)\n",
        "\n",
        "# ORDINAL + BINARY\n",
        "for col in (ordinal_features + binary_clean):\n",
        "    le = LabelEncoder()\n",
        "    le.fit(X_train_clean[col])\n",
        "\n",
        "    X_train_clean[col] = le.transform(X_train_clean[col])\n",
        "    X_test_clean[col] = X_test_clean[col].map(\n",
        "        lambda s: le.transform([s])[0] if s in le.classes_ else -1\n",
        "    )\n",
        "\n",
        "#  NOMINAL (FREQUENCY ENCODING)\n",
        "for col in nominal_clean:\n",
        "    freq = X_train_clean[col].value_counts(normalize=True)\n",
        "\n",
        "    X_train_clean[col] = X_train_clean[col].map(freq)\n",
        "\n",
        "    global_freq = 1 / len(X_train_clean)\n",
        "    X_test_clean[col] = X_test_clean[col].map(freq).fillna(global_freq)\n",
        "\n",
        "print(f\"X_train_clean: {X_train_clean.shape[1]} kolom\")"
      ]
    },
