        "discrete_mask = [col in cat_clean_mi for col in X.columns]\n",
        "\n",
        "mi_scores = mutual_info_classif(X, y, discrete_features=discrete_mask, random_state=42)\n",
        "\n",
        "mi_summary_2 = pd.DataFrame({\n",
        "    'Feature': X.columns,\n",
        "    'MI_Score': mi_scores\n",
        "}).sort_values(by='MI_Score', ascending=False)\n",
        "\n",
        "n_features = len(mi_summary_2)\n",
        "fig_height = max(6, n_features * 0.4)\n",
        "fig, ax = plt.subplots(figsize=(10, fig_height))\n",
        "\n",
        "colors = ['#e74c3c' if s > 0.05 else '#2ecc71' if s > 0.01 else '#bdc3c7'\n",
        "          for s in mi_summary_2['MI_Score']]\n",
        "bars = ax.barh(mi_summary_2['Feature'], mi_summary_2['MI_Score'],\n",
        "               color=colors, height=0.5, edgecolor='white')\n",
        "for bar, score in zip(bars, mi_summary_2['MI_Score']):\n",
        "    ax.text(bar.get_width() + 0.001, bar.get_y() + bar.get_height()/2,\n",
