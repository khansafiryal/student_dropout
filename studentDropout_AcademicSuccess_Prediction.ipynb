      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "KNN Impute selesai!\n",
            "Curricular units 1st sem (evaluations)    0\n",
            "Curricular units 2nd sem (evaluations)    0\n",
            "dtype: int64\n"
          ]
        }
      ],
      "source": [
        "from sklearn.impute import KNNImputer\n",
        "\n",
        "# 1. HITUNG IQR\n",
        "iqr_bounds = {}\n",
        "\n",
        "for col in X_train_clean.select_dtypes(include=['number']).columns:\n",
        "    Q1 = X_train_clean[col].quantile(0.25)\n",
        "    Q3 = X_train_clean[col].quantile(0.75)\n",
        "    IQR = Q3 - Q1\n",
        "\n",
        "    lower = Q1 - 1.5 * IQR\n",
        "    upper = Q3 + 1.5 * IQR\n",
        "\n",
        "    iqr_bounds[col] = {'lower': lower, 'upper': upper}\n",
        "\n",
        "\n",
        "\n",
        "# 3. FITUR YANG DIPROSES IQR\n",
        "iqr_cols = [\n",
        "    'Curricular units 1st sem (evaluations)',\n",
        "    'Curricular units 2nd sem (evaluations)',\n",
        "]\n",
        "\n",
        "# 4. APPLY IQR → JADI NaN\n",
        "for col in iqr_cols:\n",
        "    upper = iqr_bounds[col]['upper']\n",
        "    lower = iqr_bounds[col]['lower']\n",
        "\n",
        "    X_train_clean.loc[\n",
        "        (X_train_clean[col] > upper) | (X_train_clean[col] < lower),\n",
        "        col\n",
        "    ] = np.nan\n",
        "\n",
        "    X_test_clean.loc[\n",
        "        (X_test_clean[col] > upper) | (X_test_clean[col] < lower),\n",
        "        col\n",
        "    ] = np.nan\n",
        "\n",
        "# 5. KNN IMPUTATION\n",
        "knn = KNNImputer(n_neighbors=3)\n",
        "\n",
        "X_train_clean[iqr_cols] = knn.fit_transform(X_train_clean[iqr_cols])\n",
        "X_test_clean[iqr_cols] = knn.transform(X_test_clean[iqr_cols])\n",
        "\n",
        "print(\"KNN Impute selesai!\")\n",
        "print(X_train_clean[iqr_cols].isna().sum())"
      ]
    },
