      "source": [
        "# FEATURE SELECTION COMPARISON - Train/Val/Test (Tree-Based)\n",
        "\n",
        "from sklearn.model_selection import train_test_split, StratifiedKFold, learning_curve\n",
        "from sklearn.metrics import (\n",
        "    accuracy_score, fbeta_score, f1_score,\n",
        "    precision_score, recall_score\n",
        ")\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "from sklearn.tree import DecisionTreeClassifier\n",
        "from xgboost import XGBClassifier\n",
        "from lightgbm import LGBMClassifier\n",
        "from imblearn.pipeline import Pipeline as ImbPipeline\n",
        "from imblearn.over_sampling import SMOTE\n",
        "\n",
        "# Train / Val / Test split (dari X_train_tree)\n",
        "X_tr_tree, X_val_tree, y_tr_tree, y_val_tree = train_test_split(\n",
        "    X_train_tree, y_train,\n",
        "    test_size=0.2,\n",
        "    stratify=y_train,\n",
        "    random_state=42,\n",
        ")\n",
        "\n",
        "print(f\"Train : {X_tr_tree.shape[0]} | Val : {X_val_tree.shape[0]} | Test : {X_test_tree.shape[0]}\")\n",
        "\n",
        "DROPOUT_IDX = 0\n",
        "\n",
        "# 1. Helper metrik\n",
        "def compute_metrics(y_true, y_pred, prefix=''):\n",
        "    return {\n",
        "        f'{prefix}Accuracy'   : round(accuracy_score(y_true, y_pred), 4),\n",
        "        f'{prefix}Precision'  : round(precision_score(y_true, y_pred, average='macro', zero_division=0), 4),\n",
        "        f'{prefix}Recall'     : round(recall_score   (y_true, y_pred, average='macro', zero_division=0), 4),\n",
        "        f'{prefix}F1'         : round(f1_score       (y_true, y_pred, average='macro', zero_division=0), 4),\n",
        "        f'{prefix}F2 Dropout' : round(fbeta_score(y_true, y_pred, beta=2, average=None,\n",
        "                                      zero_division=0)[DROPOUT_IDX], 4),\n",
        "    }\n",
        "\n",
        "def get_models_tree():\n",
        "    return {\n",
        "        'Random Forest' : RandomForestClassifier(random_state=42),\n",
        "        'Decision Tree' : DecisionTreeClassifier(random_state=42),\n",
        "        'XGBoost'       : XGBClassifier(random_state=42, verbosity=0, eval_metric='mlogloss', n_jobs=-1),\n",
        "        'LightGBM'      : LGBMClassifier(random_state=42, verbose=-1, n_jobs=-1),\n",
        "    }\n",
        "\n",
        "# 2. FS scenarios (Menggunakan mi_summary (tree) dan sfs_tree)\n",
        "features_mi_tree = mi_summary.loc[mi_summary['MI_Score'] > 0.01, 'Feature'].tolist()\n",
        "forward_tree     = list(sfs_tree.k_feature_names_)\n",
        "\n",
        "features_mi_tree = [f for f in features_mi_tree if f in X_tr_tree.columns]\n",
        "forward_tree     = [f for f in forward_tree     if f in X_tr_tree.columns]\n",
        "\n",
        "fs_scenarios_tree = [\n",
        "    ('All Features',                 list(X_tr_tree.columns)),\n",
        "    ('MI > 0.01',                    features_mi_tree),\n",
        "    ('Sequential Forward Selection', forward_tree),\n",
        "]\n",
        "\n",
        "# 3. Loop FS x Model\n",
        "rows = []\n",
        "model_store_tree = {}  # simpan fitted model: (fs_label, model_name) -> (model, cols)\n",
        "\n",
        "for fs_label, cols in fs_scenarios_tree:\n",
        "    cols = [c for c in cols if c in X_tr_tree.columns]\n",
        "\n",
        "    X_tr_sel  = X_tr_tree[cols].copy()\n",
        "    X_val_sel = X_val_tree[cols].copy()\n",
        "    X_te_sel  = X_test_tree[cols].copy()\n",
        "\n",
        "    sm = SMOTE(random_state=42)\n",
        "    X_tr_sm, y_tr_sm = sm.fit_resample(X_tr_sel, y_tr_tree)\n",
        "\n",
        "    for model_name, model in get_models_tree().items():\n",
        "        model.fit(X_tr_sm, y_tr_sm)\n",
        "        model_store_tree[(fs_label, model_name)] = (model, cols)\n",
        "\n",
        "        val_m  = compute_metrics(y_val_tree, model.predict(X_val_sel), prefix='Val ')\n",
        "        test_m = compute_metrics(y_test,     model.predict(X_te_sel),  prefix='Test ')\n",
        "\n",
        "        rows.append({\n",
        "            'FS'     : fs_label,\n",
        "            'N Fitur': len(cols),\n",
        "            'Model'  : model_name,\n",
        "            **val_m,\n",
        "            **test_m,\n",
        "        })\n",
        "\n",
        "df_all_tree = (pd.DataFrame(rows)\n",
        "                 .sort_values('Test F2 Dropout', ascending=False)\n",
        "                 .reset_index(drop=True))\n",
        "df_all_tree.index += 1\n",
        "\n",
        "# 4. Tabel perbandingan\n",
        "val_cols  = ['FS', 'N Fitur', 'Model',\n",
        "             'Val Accuracy', 'Val Precision', 'Val Recall', 'Val F1', 'Val F2 Dropout']\n",
        "test_cols = ['FS', 'Model',\n",
        "             'Test Accuracy', 'Test Precision', 'Test Recall', 'Test F1', 'Test F2 Dropout']\n",
        "\n",
        "print(\"\\n\" + \"=\"*65)\n",
        "print(\"  TABEL PERBANDINGAN VAL\")\n",
        "print(\"=\"*65)\n",
        "print(df_all_tree[val_cols].to_string())\n",
        "\n",
        "print(\"\\n\" + \"=\"*65)\n",
        "print(\"TABEL PERBANDINGAN TEST\")\n",
        "print(\"=\"*65)\n",
        "print(df_all_tree[test_cols].to_string())\n",
        "\n",
        "# 5. Best model\n",
        "best_tree = df_all_tree.iloc[0]\n",
        "\n",
        "print(\"\\n\" + \"=\"*65)\n",
        "print(\"  BEST MODEL DAN FEATURE SELECTION (TREE-BASED)\")\n",
        "print(\"=\"*65)\n",
        "print(f\"  Model          : {best_tree['Model']}\")\n",
        "print(f\"  Feature Select.: {best_tree['FS']} ({best_tree['N Fitur']} fitur)\")\n",
        "print(f\"  {'─'*40}\")\n",
        "print(f\"  {'Metrik':<20} {'Val':>8}  {'Test':>8}\")\n",
        "print(f\"  {'─'*40}\")\n",
        "for m in ['Accuracy', 'Precision', 'Recall', 'F1', 'F2 Dropout']:\n",
        "    print(f\"  {m:<20} {best_tree[f'Val {m}']:>8.4f}  {best_tree[f'Test {m}']:>8.4f}\")\n",
        "print(f\"  {'─'*40}\")\n",
        "print(f\"  Dipilih berdasarkan Test F2 Dropout tertinggi\")\n"
      ]
