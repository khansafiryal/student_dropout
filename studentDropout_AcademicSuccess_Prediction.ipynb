      "source": [
        "from sklearn.metrics import confusion_matrix, ConfusionMatrixDisplay\n",
        "from sklearn.model_selection import StratifiedKFold, learning_curve\n",
        "from imblearn.pipeline import Pipeline as ImbPipeline\n",
        "from imblearn.over_sampling import SMOTE\n",
        "\n",
        "CLASS_NAMES = ['Dropout', 'Enrolled', 'Graduate']\n",
        "SEED = 42\n",
        "\n",
        "best_model_name_tree = best_tree['Model']\n",
        "best_fs_label_tree   = best_tree['FS']\n",
        "\n",
        "# Ambil model yang sudah di-fit dari loop sebelumnya\n",
        "best_clf_tree, best_cols_tree = model_store_tree[(best_fs_label_tree, best_model_name_tree)]\n",
        "\n",
        "print(\"=\" * 65)\n",
        "print(f\"  BEST MODEL (TREE-BASED)\")\n",
        "print(f\"  Model : {best_model_name_tree}  |  FS : {best_fs_label_tree}\")\n",
        "print(\"=\" * 65)\n",
        "\n",
        "# 1. Confusion Matrix\n",
        "cm   = confusion_matrix(y_test, best_clf_tree.predict(X_test_tree[best_cols_tree]))\n",
        "disp = ConfusionMatrixDisplay(cm, display_labels=CLASS_NAMES)\n",
        "fig, ax = plt.subplots(figsize=(5, 4))\n",
        "disp.plot(ax=ax, colorbar=False, cmap='Blues')\n",
        "ax.set_title(f'Confusion Matrix - {best_model_name_tree} ({best_fs_label_tree})',\n",
        "             fontsize=12, fontweight='bold')\n",
        "plt.tight_layout();\n",
        "plt.savefig('confusion_matrix_bestmodel_tree-based.png', dpi=150, bbox_inches='tight')\n",
        "plt.show()\n",
        "\n",
        "# 2. Learning Curve\n",
        "cv_strat = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)\n",
        "\n",
        "pipe_tree = ImbPipeline([\n",
        "    ('smote', SMOTE(random_state=SEED)),\n",
        "    ('model', get_models_tree()[best_model_name_tree]),\n",
        "])\n",
        "\n",
        "train_sz, tr_sc, val_sc = learning_curve(\n",
        "    pipe_tree,\n",
        "    X_tr_tree[best_cols_tree], y_tr_tree,\n",
        "    cv=cv_strat, scoring='accuracy',\n",
        "    train_sizes=np.linspace(0.1, 1.0, 8),\n",
        "    n_jobs=-1,\n",
        ")\n",
        "tr_m, tr_s = tr_sc.mean(axis=1), tr_sc.std(axis=1)\n",
        "va_m, va_s = val_sc.mean(axis=1), val_sc.std(axis=1)\n",
        "gap        = tr_m[-1] - va_m[-1]\n",
        "status     = ('Overfitting'  if gap > 0.10 else\n",
        "              'Underfitting' if va_m[-1] < 0.65 else 'Good Fit')\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(7, 4))\n",
